# ===== IA (toutes optionnelles : sans clé, l'app tourne en MODE DÉMO) =====
# Clé privée Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Clé gratuite https://console.groq.com/ (essayée en premier si LLM_PROVIDER=auto)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Tout fournisseur compatible OpenAI (OpenAI, OpenRouter, Mistral, serveur local…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# auto | groq | gemini | openai | demo  (chat juridique + agent)
LLM_PROVIDER=auto
# Optionnel : forcer un fournisseur différent pour l'agent uniquement
AGENT_PROVIDER=

# ===== Emails =====
# simulation (défaut) : AUCUN envoi réel, l'email apparaît « simulé » dans la boîte d'envoi
# live : envoi réel après validation humaine, via MAIL_PROVIDER
MAIL_MODE=simulation
MAIL_PROVIDER=resend
MAIL_FROM=Co-fondateur IA <no-reply@example.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ===== Données =====
# Chemin de la base JSON du workspace (défaut : data/workspace.db.json)
WORKSPACE_DB_PATH=

# ===== Comptes / sessions =====
# Secret de signature des cookies de session (OBLIGATOIRE en production ; défaut de dev sinon)
AUTH_SECRET=
# URL publique (liens magiques, retours de paiement) ; déduite de la requête sinon
APP_URL=
# true pour tester `next start` en http local (cookie non Secure) ; jamais en production
AUTH_INSECURE_COOKIE=

# ===== Abonnement =====
# on (défaut) : l'assistant co-fondateur est réservé aux abonnés ; off : ouvert à tous (dev)
BILLING_PAYWALL=on
# Prix en FCFA (sinon prix d'EXEMPLE : 9 900 et 29 900)
PRICE_COFONDATEUR_XAF=
PRICE_EQUIPE_XAF=
# simulation (défaut) | cinetpay | notchpay | stripe
PAYMENT_PROVIDER=simulation
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Connecteurs MCP et API externes (module connecteurs — voir docs/modules/mcp.md) =====
# Clé de chiffrement des secrets de connecteurs (AES-256-GCM) : 32 octets en base64 ou hex
# (ex. `openssl rand -base64 32`). OBLIGATOIRE en production ; en dev, dérivée de AUTH_SECRET.
CONNECTORS_ENCRYPTION_KEY=
# simulation | live — envois à des tiers (Gmail, Outlook, WhatsApp, Slack…) après approbation.
# Défaut : suit MAIL_MODE (donc simulation). live = envoi RÉEL.
CONNECTORS_SEND_MODE=
# true : autorise les serveurs MCP locaux en stdio (dev uniquement, ignoré en production)
MCP_ALLOW_STDIO=
# true : autorise des URL MCP sur réseau privé (10.x, 192.168.x…) ; à éviter en production
MCP_ALLOW_PRIVATE_NETWORK=
# URI de redirection OAuth unique à déclarer partout : {APP_URL}/api/mcp/oauth/callback

# Google (Gmail + Google Agenda) — Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Outlook / Graph) — Microsoft Entra ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common (défaut) | organizations | consumers | <id du locataire>
MICROSOFT_TENANT_ID=
# Meta / WhatsApp Business Cloud API
META_APP_ID=
META_APP_SECRET=
# Optionnel : configuration « Facebook Login for Business » (Embedded Signup)
META_CONFIG_ID=
# Alternative sans OAuth : jeton d'utilisateur système + identifiant du numéro
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Jeton libre choisi par vous, à recopier dans la configuration du webhook Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Slack (API Web + serveur MCP officiel Slack)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Notion (intégration publique)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_VERSION=2022-06-28
# HubSpot (application publique, API CRM)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Serveurs MCP distants qui exigent un client OAuth pré-enregistré (sans DCR)
HUBSPOT_MCP_CLIENT_ID=
HUBSPOT_MCP_CLIENT_SECRET=
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=
ASANA_MCP_CLIENT_ID=
ASANA_MCP_CLIENT_SECRET=

# ===== Module État (niveau 3, démo) =====
# worldbank (défaut) : couche réelle optionnelle via l'API publique Indicateurs de la Banque mondiale (sans clé) ; off : démo seule
ETAT_REAL_DATA=worldbank
# Code ISO3 du pays pour la couche réelle (défaut CMR)
ETAT_WB_COUNTRY=CMR
# Module entreprise : sources publiques Banque mondiale (avis de marchés, indicateurs). « off » = désactivées
ENTREPRISE_LIVE_SOURCES=
ENTREPRISE_SOURCES_TIMEOUT_MS=12000


# ===== Module memoire (mémoire, réunions, Score Co-founder, bas débit) =====
# Clé privée Ed25519 (PKCS#8 PEM, « \n » échappés acceptés, ou base64) qui signe les attestations du Score.
# Vide : clé de développement générée dans data/score-signing-key.dev.pem (attestations marquées « démo »).
# Générer : node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'pem'}))"
COFOUNDER_SCORE_SIGNING_KEY=
# Identifiants (keyId) d'anciennes clés encore acceptées après rotation, séparés par des virgules
COFOUNDER_SCORE_TRUSTED_KEY_IDS=
# Chemin de la clé de développement (défaut : à côté de la base JSON)
COFOUNDER_SCORE_KEY_FILE=
# Transcription audio des réunions : auto (Groq puis OpenAI) | groq | openai | demo
TRANSCRIPTION_PROVIDER=auto
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ── Moteur de packs métier (docs/moteur.md)
# Postgres (moteur + workspace). Vide = repli fichiers JSON (non durable sur Vercel).
DATABASE_URL=
# Dossier du repli JSON du moteur (défaut : data/engine, /tmp/cofounder-engine sur Vercel).
ENGINE_DATA_DIR=
# "vercel" pour tenter Vercel Sandbox (exige @vercel/sandbox, service facturé) ; sinon exécuteur local limité.
ENGINE_SANDBOX=
